---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import BotMascot from '../assets/bot-mascot.png';
import Layout from '../layouts/BlogPost.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
	title="About Me"
	description="Siriyak CR - AI-Augmented Biostatistics & Clinical Data Automation Specialist (8+ Years)"
	pubDate={new Date('January 14 2026')}
	heroImage={AboutHeroImage}
>
	<div class="about-container">
		<header class="header-section">
			<div class="mascot-wrapper">
				<img src={BotMascot.src} alt="AI Agent Mascot" class="bot-icon" />
			</div>
			<h1>Siriyak CR</h1>
			<p class="subtitle">AI-Augmented Biostatistician & Clinical Data Automation Specialist</p>
			<div class="header-pills">
				<span>8+ Years Experience</span>
				<span>M.Sc Statistics</span>
				<span>ICH-GCP Certified</span>
			</div>
		</header>

		<section class="intro">
			<p>
				As an <strong>AI-Augmented Biostatistician</strong>, I build <strong>intelligent infrastructure</strong> to automate clinical reporting. 
				My workflow is an inter-linked ecosystem involving <strong>Agentic AI</strong>, <strong>Pharmaverse-based automation</strong>, and <strong>Deep Oncology Biostatistics</strong>.
			</p>
		</section>

		<!-- Enhanced Knowledge Diagram -->
		<section class="knowledge-section">
			<div class="section-title">
				<h2>Inter-linked Knowledge Ecosystem</h2>
				<p>Hover over the nodes to explore the clinical automation lifecycle.</p>
			</div>
			
			<div class="knowledge-graph">
				<div class="graph-ui">
					<svg viewBox="0 0 800 500" class="interactive-svg" id="knowledge-graph-svg">
						<!-- Links -->
						<g class="links">
							<path d="M 150 250 Q 300 150 400 250" class="link-path" data-node="node-data node-auto" id="link-data-auto" />
							<path d="M 400 100 Q 400 175 400 250" class="link-path" data-node="node-ai node-auto" id="link-ai-auto" />
							<path d="M 650 250 Q 500 150 400 250" class="link-path" data-node="node-stats node-auto" id="link-stats-auto" />
							<path d="M 400 250 Q 400 375 400 450" class="link-path" data-node="node-auto node-reg" id="link-auto-reg" />
							<path d="M 650 250 Q 650 350 550 400" class="link-path" data-node="node-stats node-rwe" id="link-stats-rwe" />
						</g>

						<!-- Nodes -->
						<g class="nodes">
							<!-- AI Hub (Top) -->
							<g class="node-item" id="node-ai" data-desc="AI Agents (Antigravity/Gemini) drive the logic for code generation and RECIST 1.1 automation.">
								<circle cx="400" cy="100" r="40" class="node-circle core" />
								<text x="400" y="105" text-anchor="middle" style="fill: #fcd34d">Agentic AI</text>
							</g>

							<!-- Data Hub (Left) -->
							<g class="node-item" id="node-data" data-desc="Clinical Data (EDC/RWE/CDB) ingestion and cleaning automated via R and Python.">
								<circle cx="150" cy="250" r="35" class="node-circle" />
								<text x="150" y="255" text-anchor="middle">Clinical Data</text>
							</g>

							<!-- Automation Engine (Center) -->
							<g class="node-item" id="node-auto" data-desc="The Automation Pipeline (53+ R scripts) generating SDTM, ADaM, and ICH E3 TLFs.">
								<circle cx="400" cy="250" r="50" class="node-circle engine" />
								<text x="400" y="255" text-anchor="middle">Automation</text>
							</g>

							<!-- Stats Hub (Right) -->
							<g class="node-item" id="node-stats" data-desc="Advanced Biostatistics including Survival Analysis (RWPFS/RWOS) and Bayesian RBM.">
								<circle cx="650" cy="250" r="35" class="node-circle" />
								<text x="650" y="255" text-anchor="middle">Biostatistics</text>
							</g>

							<!-- Regulatory (Bottom) -->
							<g class="node-item" id="node-reg" data-desc="Regulatory Submission Ready: Validated XPT/RTF files for FDA/EMA/PMDA.">
								<circle cx="400" cy="450" r="35" class="node-circle goal" />
								<text x="400" y="455" text-anchor="middle">Submission</text>
							</g>
						</g>
					</svg>

					<div class="linkage-info" id="linkage-info-box">
						<h3>Knowledge Linkage Detail</h3>
						<p id="linkage-desc">Hover over a node to see how each part connects to the submission goal.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="experience-highlights">
			<h2>Career Journey</h2>
			<div class="timeline">
				<div class="timeline-item">
					<div class="time-header">
						<span class="company">KLiNERA</span>
						<span class="date">2024 – Present</span>
					</div>
					<p>Lead Clinical Database Programmer. Managing Veeva EDC automation and statistical reporting.</p>
				</div>
				<div class="timeline-item">
					<div class="time-header">
						<span class="company">CONCERTAi</span>
						<span class="date">2023 – 2024</span>
					</div>
					<p>Senior Statistical Analyst. Lead for Phase IV life-sciences data and AI-based classification.</p>
				</div>
				<div class="timeline-item">
					<div class="time-header">
						<span class="company">ELI LILLY AND COMPANY</span>
						<span class="date">2021 – 2023</span>
					</div>
					<p>Associate Manager. Automated global clinical trial reporting and developed Bayesian RBM models.</p>
				</div>
			</div>
		</section>

		<section class="resumes">
			<h2>Professional Resumes</h2>
			<div class="download-container">
				<a href={`${base}/resumes/CV-SiriyakCR.pdf`} class="download-button" download>
					📄 Final AI-CV (PDF)
				</a>
				<a href={`${base}/resumes/SiriyakCR- Biostatistician (2).pdf`} class="download-button secondary" download>
					📄 Biostatistician CV
				</a>
			</div>
		</section>
	</div>

	<script>
		// Knowledge Graph Interaction
		const nodes = document.querySelectorAll('.node-item');
		const paths = document.querySelectorAll('.link-path');
		const descBox = document.getElementById('linkage-desc');

		nodes.forEach(node => {
			node.addEventListener('mouseenter', () => {
				const nodeId = node.id;
				const desc = node.getAttribute('data-desc');
				descBox.textContent = desc;
				descBox.classList.add('highlight');

				paths.forEach(path => {
					const linkedNodes = path.getAttribute('data-node').split(' ');
					if (linkedNodes.includes(nodeId)) {
						path.classList.add('active');
					} else {
						path.style.opacity = '0.05';
					}
				});
			});

			node.addEventListener('mouseleave', () => {
				descBox.classList.remove('highlight');
				paths.forEach(path => {
					path.classList.remove('active');
					path.style.opacity = '0.4';
				});
			});
		});
	</script>

	<style>
		/* Typography & Layout */
		.about-container {
			line-height: 1.6;
			color: #1e293b;
			max-width: 1000px;
			margin: 0 auto;
			padding-bottom: 4rem;
		}

		.header-section {
			text-align: center;
			margin-bottom: 4rem;
			position: relative;
		}

		.mascot-wrapper {
			display: flex;
			justify-content: center;
			margin-bottom: 1rem;
		}

		.bot-icon {
			width: 120px;
			height: auto;
			filter: drop-shadow(0 0 15px rgba(56, 189, 248, 0.4));
			animation: float 3s ease-in-out infinite;
		}

		@keyframes float {
			0%, 100% { transform: translateY(0); }
			50% { transform: translateY(-10px); }
		}

		.header-section h1 {
			font-size: 3.5rem;
			color: #0f172a;
			margin: 0;
			background: linear-gradient(to right, #0f172a, #3b82f6);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.subtitle {
			font-size: 1.25rem;
			color: #64748b;
			margin-top: 0.5rem;
		}

		.header-pills {
			display: flex;
			justify-content: center;
			gap: 1rem;
			margin-top: 1.5rem;
		}

		.header-pills span {
			background: #f1f5f9;
			padding: 0.35rem 1rem;
			border-radius: 99px;
			font-size: 0.875rem;
			font-weight: 700;
			color: #334155;
			border: 1px solid #e2e8f0;
		}

		/* Knowledge Graph Section */
		.knowledge-section {
			background: #0f172a;
			padding: 3rem;
			border-radius: 24px;
			color: white;
			margin-bottom: 4rem;
			box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
			border: 1px solid #1e293b;
		}

		.section-title {
			text-align: center;
			margin-bottom: 2rem;
		}

		.section-title h2 {
			color: white;
			margin: 0;
			font-size: 2rem;
		}

		.section-title p {
			color: #94a3b8;
		}

		.graph-ui {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 2rem;
		}

		.interactive-svg {
			width: 100%;
			height: auto;
			max-height: 500px;
		}

		.link-path {
			fill: none;
			stroke: #38bdf8;
			stroke-width: 3;
			stroke-dasharray: 8;
			opacity: 0.4;
			transition: all 0.3s;
		}

		.link-path.active {
			opacity: 1;
			stroke: #7dd3fc;
			stroke-width: 5;
			stroke-dasharray: none;
			filter: drop-shadow(0 0 10px #38bdf8);
			animation: flow 2s linear infinite;
		}

		@keyframes flow {
			from { stroke-dashoffset: 20; }
			to { stroke-dashoffset: 0; }
		}

		.node-circle {
			fill: #1e293b;
			stroke: #38bdf8;
			stroke-width: 2;
			cursor: pointer;
			transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		}

		.node-circle.core { stroke: #fbbf24; fill: #451a03; stroke-width: 4; }
		.node-circle.engine { stroke: #22c55e; fill: #064e3b; }
		.node-circle.goal { stroke: #ef4444; fill: #450a0a; }

		.node-item:hover .node-circle {
			r: 60;
			filter: brightness(1.3) drop-shadow(0 0 15px currentColor);
		}

		.node-item text {
			fill: #f8fafc;
			font-size: 14px;
			font-weight: 700;
			pointer-events: none;
		}

		.linkage-info {
			background: #1e293b;
			padding: 2rem;
			border-radius: 16px;
			width: 100%;
			max-width: 700px;
			border: 2px solid #334155;
			text-align: center;
			box-shadow: inset 0 2px 4px rgba(0,0,0,0.3);
		}

		.linkage-info h3 {
			margin-top: 0;
			color: #38bdf8;
			font-size: 1.25rem;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}

		#linkage-desc {
			color: #cbd5e1;
			transition: all 0.3s;
			font-size: 1.1rem;
		}

		#linkage-desc.highlight {
			color: white;
		}

		/* Timeline */
		.timeline {
			margin-top: 2rem;
			border-left: 3px solid #e2e8f0;
			padding-left: 2rem;
		}

		.timeline-item {
			margin-bottom: 2.5rem;
			position: relative;
		}

		.timeline-item::before {
			content: '';
			position: absolute;
			left: -2.85rem;
			top: 0.3rem;
			width: 1.5rem;
			height: 1.5rem;
			background: #3b82f6;
			border-radius: 50%;
			border: 5px solid #fff;
			box-shadow: 0 0 0 2px #e2e8f0;
		}

		.time-header {
			display: flex;
			justify-content: space-between;
			font-weight: 700;
			font-size: 1.1rem;
		}

		.company { color: #1e40af; }
		.date { color: #64748b; }

		/* Buttons */
		.download-container {
			display: flex;
			gap: 1rem;
			margin-top: 2rem;
		}

		.download-button {
			padding: 0.85rem 1.75rem;
			background: #0f172a;
			color: white;
			text-decoration: none;
			border-radius: 10px;
			font-weight: 700;
			transition: all 0.3s;
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.download-button:hover {
			background: #334155;
			transform: translateY(-3px);
			box-shadow: 0 10px 15px -3px rgba(0,0,0,0.2);
		}

		.download-button.secondary { background: #64748b; }

		@media (max-width: 768px) {
			.knowledge-section { padding: 1.5rem; }
			.header-section h1 { font-size: 2.5rem; }
			.bot-icon { width: 90px; }
		}
	</style>
</Layout>
